# Copy to .env.local for local runs. On Vercel, add these under Settings > Environment Variables.
# Every key is optional: without it, that part runs in clearly labelled sample mode.

# AI answers, photo reading, lens, review summaries (Anthropic)
ANTHROPIC_API_KEY=
# Optional: model id (default claude-opus-5-5)
MOTZO_MODEL=

# Optional: a code testers must type before the AI answers (protects your AI credits)
MOTZO_ACCESS_CODE=

# Real nearby shops, ratings and reviews (Google Places API (New), server side)
GOOGLE_MAPS_API_KEY=
# Map on each shop page (Maps Embed API; restrict this key to your domain, it is visible in the browser)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Motzo's own voice and audio transcripts (ElevenLabs). Used first whenever the key is set.
# Without any voice key, voice mode uses the device's built-in voice.
ELEVENLABS_API_KEY=
# Optional: voice id from your ElevenLabs voice library (default JBFqnCBsd6RMkjVDRZzb)
ELEVENLABS_VOICE_ID=
# Optional: speaking model (default eleven_flash_v2_5, the fastest and cheapest)
ELEVENLABS_MODEL_ID=
# Optional: transcript model (default scribe_v2)
ELEVENLABS_STT_MODEL_ID=

# Later option instead of ElevenLabs: a self-hosted open-source voice server
# with the OpenAI audio API (/v1/audio/speech and /v1/audio/transcriptions),
# for example Speaches (Kokoro + faster-whisper) or VoiceStudio.
# Ready-to-run setup in voice-server/. Only used when ELEVENLABS_API_KEY isn't set.
MOTZO_VOICE_URL=
# Bearer key the voice server expects (Speaches: API_KEY, VoiceStudio: OMNIVOICE_API_KEY)
MOTZO_VOICE_API_KEY=
# Optional: model and voice names on that server (defaults suit Speaches)
MOTZO_TTS_MODEL=
MOTZO_TTS_VOICE=
MOTZO_STT_MODEL=
