# Copy to .env on the server and fill in. Never commit the real .env.

# The address the voice server answers on, e.g. voice.motzo.online.
# Point a DNS A record for it at this server's IP before starting.
VOICE_DOMAIN=voice.motzo.online

# A long random key. Make one with:  openssl rand -hex 32
# Put the same value in Vercel as MOTZO_VOICE_API_KEY.
SPEACHES_API_KEY=
